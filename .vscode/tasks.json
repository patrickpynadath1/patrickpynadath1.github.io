{
  "version": "2.0.0",
  "tasks": [
    {
      // Starts the local site at http://localhost:4321 when this folder opens.
      // Open it beside your writing: Cmd+Shift+P, "Simple Browser: Show".
      "label": "Site preview",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Rebuild design-map figure",
      "type": "shell",
      "command": "python3 scripts/component-figures/build_embed.py src/standalone/component-figures.html public/figures/design-map/index.html",
      "problemMatcher": []
    },
    {
      "label": "Rebuild homepage from src/data",
      "type": "shell",
      "command": "python3 scripts/sync-home-draft.py",
      "problemMatcher": []
    },
    {
      // Ctrl+Alt+A. Fetches BibTeX, adds it to dlm_bibliography.bib, copies [@key] to the clipboard.
      "label": "Add source (arXiv or DOI)",
      "type": "shell",
      "command": "python3 scripts/add_citation.py '${input:paper}'",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "paper",
      "type": "promptString",
      "description": "arXiv ID or link, or a DOI (e.g. 2310.16834 or 10.1038/nature14539)"
    }
  ]
}
