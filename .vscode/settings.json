{
  // Citation search (Pandoc Citer): type [@ or press Ctrl+Alt+C in a post.
  "PandocCiter.DefaultBibs": ["src/content/blog/dlm_bibliography.bib", "src/content/blog/zotero.bib"],
  "PandocCiter.UseDefaultBib": true,
  "PandocCiter.ForgetUnusedBib": false,
  "files.associations": {
    "*.mdx": "markdown"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.lineNumbers": "off",
    "editor.fontSize": 16,
    "editor.lineHeight": 1.7,
    "editor.padding.top": 24,
    "editor.renderWhitespace": "none",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.suggest.showWords": false,
    "editor.suggest.showSnippets": true
  },
  "zenMode.centerLayout": true,
  "zenMode.hideLineNumbers": true,
  "files.exclude": {
    "dist": true,
    ".astro": true,
    "node_modules": true
  }
}
