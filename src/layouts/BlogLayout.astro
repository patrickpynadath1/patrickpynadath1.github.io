---
import 'katex/dist/katex.min.css';
import '../styles/post.css';
import lightImages from '../data/light_images.json';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  title: string;
  description?: string;
  publishDate?: Date;
  tags?: string[];
  wip?: boolean;
  headings?: Heading[];
}

const { title, description, publishDate, tags = [], headings = [], wip = false } = Astro.props as Props;
const sections = headings.filter((h) => h.depth === 2);
const formattedDate = publishDate
  ? new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(publishDate)
  : null;
---
<!doctype html>
<html lang="en" data-theme="dark" data-hue="266">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#121321" />
    <title>{`${title} | Patrick Pynadath`}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      try { var s = localStorage.getItem('wave-study-theme'); if (s === 'light' || s === 'dark') document.documentElement.dataset.theme = s; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#article">Skip to article</a>
    <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

    <div class="shell">
      <header class="site-header">
        <a class="identity" href="/" aria-label="Patrick Pynadath, home">
          <span class="portrait"><img src="/images/pic.jpg" width="52" height="52" alt="" /></span>
          <span>Patrick Pynadath</span>
        </a>
        <div class="header-tools">
          <a class="back-link" href="/blog/">&larr; Blog</a>
          <button id="theme" type="button" aria-label="Switch to light mode" title="Switch theme">
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.7 13.2A9 9 0 0 1 10.8 3.3a9 9 0 1 0 9.9 9.9z"/></svg>
          </button>
        </div>
      </header>

      <div class="post-meta">
        <span class="eyebrow">Research note</span>
        {wip && <span class="wip-badge">Work in progress</span>}
        {formattedDate && publishDate && <time datetime={publishDate.toISOString()}>{formattedDate}</time>}
        {tags.length > 0 && <div class="tags">{tags.map((tag) => <span>{tag}</span>)}</div>}
      </div>

      <main class="post-grid">
        {sections.length > 0 && (
          <nav class="toc" aria-label="Contents">
            <span class="label">Contents</span>
            <ol>
              {sections.map((h, i) => (
                <li><a href={`#${h.slug}`} data-target={h.slug}><span class="toc-num">{i + 1}</span>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}
        <article class="prose" id="article">
          <slot />
        </article>
      </main>

      <footer class="site-footer">
        <span>Patrick Pynadath</span>
        <a href="/blog/">More posts</a>
      </footer>
    </div>

    <div class="cite-pop" id="cite-pop" role="tooltip" hidden></div>

    <script is:inline define:vars={{ lightImages }}>
      // Figures made for the dark theme have a "-light" twin (scripts/relight_images.py).
      // Show the twin whenever the page is in light mode.
      (function () {
        var root = document.documentElement;
        var hasLight = new Set(lightImages);
        function swapImages() {
          var light = root.dataset.theme === 'light';
          document.querySelectorAll('.prose img').forEach(function (img) {
            var base = img.dataset.darkSrc || img.getAttribute('src');
            if (!hasLight.has(base)) return;
            img.dataset.darkSrc = base;
            var next = light ? base.replace(/(\.[a-z0-9]+)$/i, '-light$1') : base;
            if (img.getAttribute('src') !== next) img.setAttribute('src', next);
          });
        }
        swapImages();
        new MutationObserver(swapImages).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>

    <script is:inline>
      (function () {
        var root = document.documentElement;

        var themeBtn = document.getElementById('theme');
        function syncLabel() {
          themeBtn.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark mode' : 'Switch to light mode');
        }
        themeBtn.addEventListener('click', function () {
          root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
          try { localStorage.setItem('wave-study-theme', root.dataset.theme); } catch (e) {}
          syncLabel();
        });
        syncLabel();

        var article = document.getElementById('article');
        var bar = document.getElementById('progress-bar');
        var links = Array.prototype.slice.call(document.querySelectorAll('.toc a'));
        var targets = links.map(function (a) { return document.getElementById(a.dataset.target); });
        function onScroll() {
          var r = article.getBoundingClientRect();
          var total = r.height - innerHeight;
          bar.style.transform = 'scaleX(' + (total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0) + ')';
          var current = 0;
          targets.forEach(function (t, i) { if (t && t.getBoundingClientRect().top < innerHeight * 0.3) current = i; });
          links.forEach(function (a, i) { a.classList.toggle('active', i === current); });
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);
        onScroll();

        // Hover or focus a citation to preview its reference.
        var pop = document.getElementById('cite-pop');
        function show(el) {
          var target = document.getElementById(decodeURIComponent(el.getAttribute('href').slice(1)));
          var body = target && (target.querySelector('.csl-right-inline') || target);
          if (!body) return;
          pop.innerHTML = '<strong>[' + el.textContent + ']</strong> ' + body.innerHTML;
          pop.hidden = false;
          var r = el.getBoundingClientRect();
          var w = pop.offsetWidth;
          var left = Math.min(Math.max(16, r.left + scrollX - w / 2 + r.width / 2), scrollX + root.clientWidth - w - 16);
          pop.style.left = left + 'px';
          pop.style.top = (r.bottom + scrollY + 8) + 'px';
        }
        function hide() { pop.hidden = true; }
        document.querySelectorAll('a[href^="#bib-"]').forEach(function (el) {
          el.setAttribute('aria-describedby', 'cite-pop');
          el.addEventListener('mouseenter', function () { show(el); });
          el.addEventListener('focus', function () { show(el); });
          el.addEventListener('mouseleave', hide);
          el.addEventListener('blur', hide);
        });
        addEventListener('keydown', function (e) { if (e.key === 'Escape') hide(); });
      })();
    </script>
  </body>
</html>
