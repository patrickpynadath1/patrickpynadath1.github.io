---
import Badge from '../ui/Badge.astro';
import '../../styles/components/badges.css';

interface Links {
  website?: string;
  arxiv?: string;
  github?: string;
}

interface Props {
  conference: string;
  links: Links;
  showConference?: boolean;
}

const { conference, links, showConference = true } = Astro.props as Props;
---
<div class="badge-cluster">
  {showConference && <Badge label={conference} kind="conference" />}
  {links.website && <Badge href={links.website} label="🌐 Website" kind="website" />}
  {links.arxiv && <Badge href={links.arxiv} label="📄 arXiv" kind="arxiv" />}
  {links.github && <Badge href={links.github} label="💻 GitHub" kind="github" />}
</div>
