---
import '../../styles/components/expandable.css';

interface Props {
  theme?: string;
  sectionClass?: string;
}

const { theme, sectionClass } = Astro.props as Props;
const classes = [
  'expandable-section',
  theme ? `theme-${theme}` : '',
  sectionClass ?? '',
]
  .join(' ')
  .replace(/\s+/g, ' ')
  .trim();
---
<details class={classes}>
  <summary>
    <slot name="header" />
    <div class="section-tldr"><slot name="tldr" /></div>
    <slot name="actions" />
  </summary>
  <div class="paper-details-body"><slot /></div>
</details>
