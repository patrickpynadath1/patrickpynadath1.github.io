---
import '../../styles/components/footer.css';

interface Props {
  links: {
    email?: string;
    twitter?: string;
    github?: string;
    linkedin?: string;
  };
}

const { links } = Astro.props as Props;
---
<footer class="footer">
  <div class="container">
    <div class="content has-text-centered">
      {links.email && (
        <a class="icon-link" href={`mailto:${links.email}`}>
          <i class="fas fa-envelope"></i>
        </a>
      )}
      {links.twitter && (
        <a class="icon-link" href={links.twitter} target="_blank">
          <i class="fab fa-twitter"></i>
        </a>
      )}
      {links.github && (
        <a class="icon-link" href={links.github} target="_blank">
          <i class="fab fa-github"></i>
        </a>
      )}
      {links.linkedin && (
        <a class="icon-link" href={links.linkedin} target="_blank">
          <i class="fab fa-linkedin"></i>
        </a>
      )}
    </div>
    <div class="columns is-centered">
      <div class="column is-8">
        <div class="content">
          <p>
            © 2025. This website template is based on the <a href="https://github.com/nerfies/nerfies.github.io">Nerfies project page</a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>
