@misc{davisDesignSpaceContinuous2026,
  title = {On the {{Design Space}} of {{Continuous Diffusion Language Models}}},
  author = {Davis, Oscar and Roos, Daan and Bizeul, Alice and Shidani, Amitis and Turrisi, Victor and B{\'e}thune, Louis and Ablin, Pierre and Cuturi, Marco},
  year = 2026,
  month = oct,
  number = {arXiv:2610.13834},
  eprint = {2610.13834},
  primaryclass = {cs.LG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2610.13834},
  urldate = {2026-10-29},
  abstract = {Continuous diffusion language models (CDLMs) promise to bring the benefits of continuous flow modelling to language, including accelerated sampling and controllable generation. The field has grown rapidly, and the capabilities of CDLMs have begun to rival those of discrete diffusion. Yet, unlike for continuous modalities such as images or videos, our grasp of the levers that matter when training CDLMs remains limited. In this work, we focus on two of these levers, namely self-conditioning and embedding geometry, and shed light on some of the mechanisms behind them, which in turn suggest cheaper and more effective designs. We begin by showing that self-conditioning corrects a train/inference mismatch by exposing the model to inference-like states that are otherwise rare during training. These gains can be recovered without an extra forward pass by a two-level interpolant, coined \$\textbackslash mathrm\textbraceleft DoubleCat\textbraceright\$, which improves TinyGSM accuracy more than threefold. Self-conditioning also aids in recognising tokens dominated by large-norm Gaussians\$\textbackslash unicode\textbraceleft x2013\textbraceright\$an issue known as token identifiability. To address it directly, we introduce discrete reveals to \$\textbackslash mathrm\textbraceleft DoubleCat\textbraceright\$, yielding \$\textbackslash mathrm\textbraceleft SemiCat\textbraceright\$, which achieves discrete diffusion-level performance on TinyGSM, reaching \$49.94\textbackslash\%\$ with standard training hyperparameters and a tuned sampler. At the \$1.7\$B scale, \$\textbackslash mathrm\textbraceleft SemiCat\textbraceright\$ outperforms discrete diffusion on four of six likelihood-based evaluations, and surpasses one-hot flows on unconditional generation. On embedded spaces, we find that cross-entropy drives embeddings towards a geometry whose decoding error rate closely matches the one-hot one. We briefly explore a range of further options, such as hybrid corruption processes and noise schedules, including asynchronous ones. We believe this exploration can help the community better understand and advance the design space of CDLMs.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning},
  file = {/Users/patrickpynadath/Zotero/storage/MTHMLDV5/Davis et al. - 2026 - On the Design Space of Continuous Diffusion Language Models.pdf;/Users/patrickpynadath/Zotero/storage/DC2AAXR6/2610.html}
