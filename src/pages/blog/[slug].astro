---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => import.meta.env.DEV || !post.data.local) // local-only posts never build
    .map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, tags, wip, comments, sparknotes } = post.data;
// Draft posts keep their source but publish only a placeholder at their URL, so links to them still resolve.
const draft = !!post.data.draft && import.meta.env.PROD; // drafts stay readable on the local dev server
const { Content, headings } = await post.render();
---
<BlogLayout
  title={title}
  description={description}
  publishDate={pubDate}
  tags={tags}
  wip={wip}
  comments={comments}
  sparknotes={sparknotes}
  headings={draft ? [] : headings}
>
  {draft ? <p>This post is not published yet. Check back soon.</p> : <Content />}
</BlogLayout>
