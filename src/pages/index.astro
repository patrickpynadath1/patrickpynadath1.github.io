---
import homepage from '../../public/home-draft/index.html?raw';

// Reuse the approved standalone design so the preview and homepage stay in sync.
const html = homepage
  .replace('<meta name="robots" content="noindex">', '<meta name="description" content="Patrick Pynadath — PhD student at Purdue University researching probabilistic machine learning and diffusion models."><link rel="canonical" href="https://patrickpynadath1.github.io/">')
  .replace('<title>Patrick Pynadath — homepage draft</title>', '<title>Patrick Pynadath</title>')
  .replaceAll('"./draft.', '"/home-draft/draft.')
  .replaceAll('"./wave.js', '"/home-draft/wave.js');
---
<Fragment set:html={html} />
